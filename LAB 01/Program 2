
#include<iostream.h>
#include<conio.h>

class Matrix
{
    int a[10][10], b[10][10], c[10][10];
    int r, col;

    public:

    void input();
    void display();
    void addition();
    void transpose();
};

void Matrix::input()
{
    int i, j;

    cout<<"Enter number of rows: ";
    cin>>r;

    cout<<"Enter number of columns: ";
    cin>>col;

    cout<<"\nEnter matrix elements:\n";

    for(i=0; i<r; i++)
    {
        for(j=0; j<col; j++)
        {
            cin>>a[i][j];
        }
    }
}

void Matrix::display()
{
    int i, j;

    cout<<"\nMatrix is:\n";

    for(i=0; i<r; i++)
    {
        for(j=0; j<col; j++)
        {
            cout<<a[i][j]<<" ";
        }

        cout<<"\n";
    }
}

void Matrix::addition()
{
    int i, j;

    cout<<"\nEnter second matrix:\n";

    for(i=0; i<r; i++)
    {
        for(j=0; j<col; j++)
        {
            cin>>b[i][j];
        }
    }

    cout<<"\nAddition of matrices:\n";

    for(i=0; i<r; i++)
    {
        for(j=0; j<col; j++)
        {
            c[i][j]=a[i][j]+b[i][j];
            cout<<c[i][j]<<" ";
        }

        cout<<"\n";
    }
}

void Matrix::transpose()
{
    int i, j;

    cout<<"\nTranspose of matrix:\n";

    for(i=0; i<col; i++)
    {
        for(j=0; j<r; j++)
        {
            cout<<a[j][i]<<" ";
        }

        cout<<"\n";
    }
}

void main()
{
    clrscr();

    Matrix obj;
    int choice;

    obj.input();

    do
    {
        cout<<"\n\n--- 2D ARRAY OPERATIONS ---";
        cout<<"\n1. Display";
        cout<<"\n2. Addition";
        cout<<"\n3. Transpose";
        cout<<"\n4. Exit";

        cout<<"\nEnter your choice: ";
        cin>>choice;

        switch(choice)
        {
            case 1:
                obj.display();
                break;

            case 2:
                obj.addition();
                break;

            case 3:
                obj.transpose();
                break;

            case 4:
                cout<<"Exit";
                break;

            default:
                cout<<"Wrong choice";
        }

    }while(choice!=4);

    getch();
}
