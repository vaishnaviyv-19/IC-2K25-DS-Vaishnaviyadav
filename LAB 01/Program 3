
#include<iostream.h>
#include<conio.h>

class Matrix
{
    int a[10][10], b[10][10], c[10][10];
    int r, col;

    public:

    void input();
    void addition();
    void subtraction();
    void multiplication();
    void transpose();
    void display();
};

void Matrix::input()
{
    int i, j;

    cout<<"Enter rows: ";
    cin>>r;

    cout<<"Enter columns: ";
    cin>>col;

    cout<<"\nEnter first matrix:\n";

    for(i=0; i<r; i++)
    {
        for(j=0; j<col; j++)
        {
            cin>>a[i][j];
        }
    }

    cout<<"\nEnter second matrix:\n";

    for(i=0; i<r; i++)
    {
        for(j=0; j<col; j++)
        {
            cin>>b[i][j];
        }
    }
}

void Matrix::addition()
{
    int i, j;

    for(i=0; i<r; i++)
    {
        for(j=0; j<col; j++)
        {
            c[i][j]=a[i][j]+b[i][j];
        }
    }

    cout<<"\nAddition Result:\n";
    display();
}

void Matrix::subtraction()
{
    int i, j;

    for(i=0; i<r; i++)
    {
        for(j=0; j<col; j++)
        {
            c[i][j]=a[i][j]-b[i][j];
        }
    }

    cout<<"\nSubtraction Result:\n";
    display();
}

void Matrix::multiplication()
{
    int i, j, k;

    for(i=0; i<r; i++)
    {
        for(j=0; j<col; j++)
        {
            c[i][j]=0;

            for(k=0; k<col; k++)
            {
                c[i][j]=c[i][j]+a[i][k]*b[k][j];
            }
        }
    }

    cout<<"\nMultiplication Result:\n";
    display();
}

void Matrix::transpose()
{
    int i, j;

    cout<<"\nTranspose of First Matrix:\n";

    for(i=0; i<col; i++)
    {
        for(j=0; j<r; j++)
        {
            cout<<a[j][i]<<" ";
        }

        cout<<"\n";
    }
}

void Matrix::display()
{
    int i, j;

    for(i=0; i<r; i++)
    {
        for(j=0; j<col; j++)
        {
            cout<<c[i][j]<<" ";
        }

        cout<<"\n";
    }
}

void main()
{
    clrscr();

    Matrix m;
    int choice;

    m.input();

    do
    {
        cout<<"\n\n--- MATRIX CALCULATOR ---";
        cout<<"\n1. Addition";
        cout<<"\n2. Subtraction";
        cout<<"\n3. Multiplication";
        cout<<"\n4. Transpose";
        cout<<"\n5. Exit";

        cout<<"\nEnter your choice: ";
        cin>>choice;

        switch(choice)
        {
            case 1:
                m.addition();
                break;

            case 2:
                m.subtraction();
                break;

            case 3:
                m.multiplication();
                break;

            case 4:
                m.transpose();
                break;

            case 5:
                cout<<"Thank You!";
                break;

            default:
                cout<<"Invalid choice";
        }

    }while(choice!=5);

    getch();
}
