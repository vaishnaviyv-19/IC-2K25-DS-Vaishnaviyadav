#include<iostream.h>
#include<conio.h>

#define MAX 5

class IS
{
    int a[MAX];

public:

    void input()
    {
        cout<<"Enter array elements:";
        for(int i=0;i<MAX;i++)
        {
            cin>>a[i];
        }
    }

    void Insertion_sort();

    void display()
    {
        cout<<"\nSorted array is:";
        for(int i=0;i<MAX;i++)
        {
            cout<<a[i]<<" ";
        }
    }
};

void IS::Insertion_sort()
{
    int temp;

    for(int i=1;i<MAX;i++)
    {
        temp=a[i];
        int j=i-1;

        while(j>=0 && a[j]>temp)
        {
            a[j+1]=a[j];
            j--;
        }

        a[j+1]=temp;
    }
}

void main()
{
    clrscr();

    IS s;
    s.input();
    s.Insertion_sort();
    s.display();

    getch();
}
