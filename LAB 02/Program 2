#include<iostream.h>
#include<conio.h>

#define MAX 5

class SS
{
    int a[MAX];

public:

    void input()
    {
        cout<<"Enter array elements:";
        for(int i=0;i<MAX;i++)
        {
            cin>>a[i];
        }
    }

    void Selection_sort();

    void display()
    {
        cout<<"\nSorted array is:";
        for(int i=0;i<MAX;i++)
        {
            cout<<a[i]<<" ";
        }
    }
};

void SS::Selection_sort()
{
    for(int i=0;i<MAX-1;i++)
    {
        for(int j=i+1;j<MAX;j++)
        {
            if(a[i]>a[j])
            {
                int t=a[i];
                a[i]=a[j];
                a[j]=t;
            }
        }
    }
}

void main()
{
    clrscr();

    SS s;
    s.input();
    s.Selection_sort();
    s.display();

    getch();
}
